# Copy to runtime.env (gitignored); one Runtime per person.
# This sets the Relay URL, but it does not automatically log in an account.
NANOMUSE_CLOUD_BASE_URL=https://relay.example.com
NANOMUSE_HUB_NAME=NAS-Agent
NANOMUSE_SERVER_TOKEN=REPLACE_WITH_A_DISTINCT_LONG_RANDOM_SECRET
# Sign in to this person's Relay account through the Runtime Web UI.
