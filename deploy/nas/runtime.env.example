# Common template: copy independently to runtime-1.env and runtime-2.env.
# Both destination files are gitignored. Do not reuse tokens or local state.
# Each Runtime explicitly signs in to its own whitelisted Relay account via Web.
# Changing this URL does NOT bind it to a Relay identity automatically.
NANOMUSE_CLOUD_BASE_URL=https://muse.rontian.top
NANOMUSE_HUB_NAME=REPLACE_WITH_UNIQUE_DEVICE_NAME
NANOMUSE_SERVER_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_HEX_32_PER_RUNTIME
# Use this Runtime's private browser Web interface to log in once to Relay.
# The Web token is not a Relay auth token. Avoid submitting either to git.
