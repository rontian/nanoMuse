# Compose interpolation settings only. Copy to .env and set the actual NAS path.
# .env, relay.env and runtime-*.env are private and must never be committed.
NANOMUSE_DATA_ROOT=/volume1/docker/nanomuse

# Host:container bindings; NPS on the NAS host can reach 127.0.0.1.
# If NPS runs in another container, use a restricted reachable IP and firewall.
RELAY_BIND_IP=127.0.0.1
RELAY_PORT=8787

# Runtime Web is privileged: bind privately. Runtime Hub does NOT need these ports.
RUNTIME_BIND_IP=127.0.0.1
RUNTIME_1_PORT=8788
RUNTIME_2_PORT=8789
# Use a reviewed fixed release tag; replace with a verified digest if preferred.
RUNTIME_IMAGE_TAG=1.0.5
