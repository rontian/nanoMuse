# Copy to /volume1/docker/nanoMuse/config/.env (outside the Git repository).
# Change paths if you choose another NAS root; 'source/' is the cloned Git repo.
NANOMUSE_CONFIG_ROOT=/volume1/docker/nanoMuse/config
NANOMUSE_DATA_ROOT=/volume1/docker/nanoMuse/data
NANOMUSE_BACKUP_DIR=/volume1/docker/nanoMuse/backups/relay

# These NAS host listeners must be reachable from the NPS client.
# Bind to loopback only when NPS runs on the NAS host network namespace.
RELAY_BIND_IP=127.0.0.1
RELAY_PORT=8787
RUNTIME_BIND_IP=127.0.0.1
RUNTIME_1_PORT=8788
RUNTIME_2_PORT=8789

# Confirm the actual released runtime image and supported architecture before rollout.
RUNTIME_IMAGE_TAG=1.0.5
