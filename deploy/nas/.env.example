# Compose interpolation settings only. Copy to .env; do not commit secrets.
# Replace example directory with the persistent path of your actual NAS.
NANOMUSE_DATA_ROOT=/volume1/docker/nanomuse
# Bind loopback when NPS can reach NAS host loopback. Otherwise choose a secured interface.
RELAY_BIND_IP=127.0.0.1
RELAY_PORT=8787
# Runtime Web is a privileged interface; access privately, never expose directly.
RUNTIME_BIND_IP=127.0.0.1
RUNTIME_PORT=8788
RUNTIME_OWNER=primary
RUNTIME_IMAGE_TAG=1.0.5
