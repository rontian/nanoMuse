# Copy to relay.env (gitignored). All REPLACE values must be changed.
# Public HTTPS/WSS address of the self-hosted Relay.
PUBLIC_BASE=https://muse.rontian.top
CLOUD_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
CLOUD_ADMIN_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
# Existing Magpie OR CLIProxyAPI gateway (OpenAI-compatible).
UPSTREAM_BASE=https://gateway.example.com/v1
UPSTREAM_KEY=REPLACE_WITH_GATEWAY_API_KEY
# IMPORTANT: Fill ALLOWED_IDENTIFIERS in the private relay.env, NOT this public repo.
# Real reachable email inboxes are required when CODE_SENDER=smtp.
SIGNUP_OPEN=0
ALLOWED_IDENTIFIERS=REPLACE_WITH_TWO_PRIVATE_EMAILS
IMPROVE_DEFAULT=0
# Members use only allowed models; replace IDs with real gateway IDs.
CLOUD_ANY_MODEL_MEMBERS=0
CLOUD_CATALOG=0
CLOUD_CATALOG_PROBE=0
CLOUD_MODELS=[{"id":"REPLACE_WITH_MODEL_ID","name":"Family Chat","upstream":"REPLACE_WITH_MODEL_ID","input_modalities":["text"],"for":["chat"],"recommended":true,"recommended_for":["chat"],"price_in":0,"price_out":0}]
CLOUD_MEDIA_ENABLED=0
# LAN test: log; switch to smtp for normal use.
CODE_SENDER=log
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nanoMuse <no-reply@example.com>
HUB_ENABLED=true
HUB_FRAME_LIMIT=16777216
MAX_REQUEST_BYTES=16777216
PER_MINUTE_REQUESTS=30
# Limit to the real forwarding proxy addresses after network verification.
# TRUSTED_PROXIES=172.17.0.1/32
REVIEW_ADDRESSES=
REVIEW_CODE=
